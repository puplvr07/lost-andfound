rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the logged-in user is an admin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for your lost and found posts
    match /posts/{postId} {
      // Anyone can view active posts
      allow read: if true;
      
      // Logged-in users can create new posts
      allow create: if request.auth != null;
      
      // ONLY ADMINS can update (archive/resolve) or delete posts
      allow update, delete: if isAdmin();
    }
    
    // Rules for user profiles
    match /users/{userId} {
      // Users can read and write their own profile data
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}