rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the logged-in user is an admin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for lost and found reports
    match /reports/{reportId} {
      // Reports are visible to signed-in users through the portal.
      allow read: if true;

      allow create: if request.auth != null;

      // Only the original poster can mark their own report as resolved.
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.status == 'resolved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt']);

      allow delete: if false;
    }
    
    // Rules for user profiles
    match /users/{userId} {
      // Users can read and write their own profile data
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}